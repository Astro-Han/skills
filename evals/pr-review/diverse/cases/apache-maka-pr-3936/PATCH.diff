+          createdAt: '2026-01-01T00:00:00.000Z',
+        },
+      ],
+    }),
+    'utf8',
+  );
+
+  const file = await readAccessCredentialFile(path);
+  assert.deepEqual(file.credentials[0]?.operationGrants, ['host.status']);
