     let mut form = reqwest::multipart::Form::new();
     for (key, value) in form_metadata.iter() {
         form = form.text(*key, value.clone());
@@ -1499,16 +1504,16 @@ fn build_metadata_request<'a>(
         Credentials::Basic { password, .. } => {
             if password.is_some() {
