+function toNetworkDestinationUrl(url: string): string | undefined {
+	try {
+		const parsed = new URL(url);
+		if (parsed.protocol === 'http:' || parsed.protocol === 'https:') {
+			return parsed.origin + parsed.pathname + parsed.search;
+		}
