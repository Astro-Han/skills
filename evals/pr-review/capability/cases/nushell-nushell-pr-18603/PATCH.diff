diff --git a/crates/nu-protocol/src/parser_path.rs b/crates/nu-protocol/src/parser_path.rs
index b230e4e6e2238..30452ae56bb37 100644
--- a/crates/nu-protocol/src/parser_path.rs
+++ b/crates/nu-protocol/src/parser_path.rs
@@ -7,6 +7,91 @@ use std::{
     path::{Path, PathBuf},
