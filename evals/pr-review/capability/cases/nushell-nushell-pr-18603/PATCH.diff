+        }),
+        Err(ScriptLoadError::NotText) => Err(ParseError::ScriptFileNotText {
+            path: display_path,
+            span,
+        }),
+        Err(ScriptLoadError::Unreadable) => {
+            Err(ParseError::SourcedFileNotFound(display_path, span))
+        }
+    }
