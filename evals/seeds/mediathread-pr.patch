@@ -1,5 +1,14 @@
 from .model import Session
 
 
-def clone_session(session: Session) -> Session:
-    return Session(tuple(session.messages), tuple(session.ledger))
+def _rewrite(text: str, artifact_ids: dict[str, str]) -> str:
+    for source, target in artifact_ids.items():
+        text = text.replace(f"media://{source}", f"media://{target}")
+    return text
+
+
+def clone_session(
+    session: Session, artifact_ids: dict[str, str] | None = None
+) -> Session:
+    artifact_ids = artifact_ids or {}
+    messages = tuple(_rewrite(text, artifact_ids) for text in session.messages)
+    return Session(messages, tuple(session.ledger))
diff --git a/mediathread/loader.py b/mediathread/loader.py
new file mode 100644
index 0000000..075be33
--- /dev/null
+++ b/mediathread/loader.py
@@ -0,0 +1,16 @@
+from collections.abc import Callable
+
+
+class ImageLoader:
+    def __init__(self, reader: Callable[[str], bytes | None]):
+        self._reader = reader
+        self._cache: dict[str, bytes | None] = {}
+
+    def load(self, artifact_id: str) -> bytes | None:
+        if artifact_id not in self._cache:
+            self._cache[artifact_id] = self._reader(artifact_id)
+        return self._cache[artifact_id]
