 from html import escape
+import re
+
+from .loader import ImageLoader
+from .registry import IMAGE_SOURCES
+
+
+IMAGE = re.compile(r"!\[([^]]*)\]\(([^)]+)\)")
 
 
-def render(markdown: str) -> str:
+def render(markdown: str, loader: ImageLoader | None = None) -> str:
+    match = IMAGE.fullmatch(markdown)
+    if match and loader and IMAGE_SOURCES.accepts(match.group(2)):
+        alt, source = match.groups()
+        data = loader.load(source.removeprefix("media://"))
+        if data is not None:
+            return f'<img alt="{escape(alt)}" data-size="{len(data)}">'
     return f"<p>{escape(markdown)}</p>"
diff --git a/mediathread/registry.py b/mediathread/registry.py
new file mode 100644
index 0000000..6e13104
--- /dev/null
+++ b/mediathread/registry.py
@@ -0,0 +1,16 @@
+class ImageSourceRegistry:
+    def __init__(self) -> None:
+        self._prefixes: list[str] = []
+
+    def register(self, prefix: str) -> None:
+        self._prefixes.append(prefix)
+
+    def accepts(self, source: str) -> bool:
+        return any(source.startswith(prefix) for prefix in self._prefixes)
+
+
+IMAGE_SOURCES = ImageSourceRegistry()
+IMAGE_SOURCES.register("media://")
